  m_TableData:
  - m_Id: 32879767552
    m_Localized: "Ouvrez votre main pour analyser un \xE9l\xE9ment"
    m_Metadata:
      m_Items: []
  - m_Id: 691129643008
    m_Localized: "Fermez votre main pour analyser totalement l'\xE9lement. Tournez
      votre poignet pour controler la vitesse."
    m_Metadata:
      m_Items: []
  - m_Id: 316241726763008
    m_Localized: "Param\xE8tres"
    m_Metadata:
      m_Items: []
  - m_Id: 7873691778850816
    m_Localized: "Pincez la sph\xE8re \"Commencer\" avec vos doigts"
    m_Metadata:
      m_Items: []
  - m_Id: 7882407982964736
    m_Localized: "Placez la sph\xE8re \"Commencer\" dans le r\xE9ceptacle juste au-dessus"
    m_Metadata:
      m_Items: []
  - m_Id: 7906249522585600
    m_Localized: Fermez votre main
    m_Metadata:
      m_Items: []
  - m_Id: 7908052263804928
    m_Localized: Tournez votre poignet
    m_Metadata:
      m_Items: []
  - m_Id: 10032311375273984
    m_Localized: "Libert\xE9"
    m_Metadata:
      m_Items: []
