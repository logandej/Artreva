    "m_SourceType": 1,
    "m_FunctionName": "GrayToColor",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "if (gray < 0.33)\r\n    ColorOut = Color1;\r\nelse if (gray < 0.66)\r\n    ColorOut = Color2;\r\nelse\r\n    ColorOut = Color3;\n"
}

