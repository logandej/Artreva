    m_Metadata:
      m_Items: []
  - m_Id: 23222991656361984
    m_Localized: Ouvrez votre main en pointant cette colonne
    m_Metadata:
      m_Items: []
  - m_Id: 27525586994634752
    m_Localized: "Le d\xE9partement du Var vous remercie d'avoir jou\xE9 !"
    m_Metadata:
      m_Items: []
